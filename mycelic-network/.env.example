# Defaults: Circle Gateway testnet, Arc Testnet preferred. Test USDC has no monetary value.
MYCELIC_PAYMENT_ENV=testnet
MYCELIC_TREASURY_ADDRESS=0x1f89928f6694dbd02fe77f9fdd7094a774f6d329
# Set a unique stable service identifier before creating deployment rooms.
MYCELIC_SERVICE_ID=mycelic.local
# Canonical public origin; set to your deployment URL before hosting.
MYCELIC_PUBLIC_URL=https://automatic-space-waffle-r4r4gw9g75j625g7r-3000.app.github.dev
# Node.js 24+ with a persistent writable directory. Back up the ledger and key.
MYCELIC_DATA_DIR=.mycelic-data
# REQUIRED for npm start/production. Use scripts/setup.ts to generate locally.
# This signs Mycelic receipts only; NEVER use your treasury or spending wallet key.
MYCELIC_RECEIPT_PRIVATE_KEY=
# Mainnet requires BOTH MYCELIC_PAYMENT_ENV=mainnet and this flag. Disabled by default.
MYCELIC_ENABLE_MAINNET=false
# Optional static TURN for controlled tests on restrictive NATs.
# Public hosting needs a runtime short-lived credential endpoint (not implemented).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
NEXT_PUBLIC_NOSTR_RELAY_URL=
NEXT_PUBLIC_STUN_URL=
# Optional RPCs for NFT gates
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_OPTIMISM_RPC_URL=
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
# Agent process only. Do not expose these as NEXT_PUBLIC variables.
# AGENT_WALLET_PRIVATE_KEY=
# MYCELIC_URL=http://127.0.0.1:3000
# MYCELIC_PAYMENT_CHAIN=arcTestnet
# AGENT_MAX_SPEND_USDC=4.20
# AGENT_ALLOW_MAINNET=false
